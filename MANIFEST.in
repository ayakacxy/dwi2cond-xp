include LICENSE
include THIRD_PARTY_NOTICES.md
include CITATION.cff
include .editorconfig
include README.md
include README.zh-CN.md
include environment.yml
include constraints-simnibs46.txt
recursive-include docs *.md
# Ship the self-contained post-remediation audit artifacts with the source archive.
include docs/V0.3.0_POST_REMEDIATION_REAUDIT_REPORT_2026-08-26.html
include docs/V0.3.0_POST_REMEDIATION_REAUDIT_ARTIFACT_2026-08-26.json
